# 页面标题（勿在等号两侧加空格，否则可能注入失败仍显示旧标题）
VUE_APP_TITLE=Battery Management System

# 开发环境配置
ENV = 'development'

# 热调试：dev-server 端口（与生产 Nginx:80 + /opt/bbms/web/dist 无关，勿改生产）
port=9527

# 开发环境 API 前缀，由 devServer 代理到本机 9099（与 systemd bbms-web 一致）
VUE_APP_BASE_API = '/dev-api'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true
